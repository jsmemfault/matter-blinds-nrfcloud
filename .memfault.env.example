# Copy to .memfault.env (gitignored) and fill in.
#
# The organization auth token grants write access across the whole
# organization, so it must never be committed. Create one at
#   app.memfault.com -> Settings -> Organization Auth Tokens
export MEMFAULT_ORG_TOKEN='oat_...'

# Both slugs appear in the app.memfault.com URL:
#   app.memfault.com/organizations/<MEMFAULT_ORG>/projects/<MEMFAULT_PROJECT>
export MEMFAULT_ORG=''
export MEMFAULT_PROJECT=''
