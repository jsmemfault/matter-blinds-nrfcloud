/*
 * Memfault heartbeat metrics — smart window covering on nRF52840.
 *
 * Three groups, and the split is deliberate:
 *
 *  - ot_* / matter_* are the CONNECTIVITY metrics. These are what answer
 *    "does our product behave on Apple vs Google vs Amazon vs Eero." Segment
 *    them by the matter_admin_vendor_id attribute and the ecosystem-specific
 *    failure modes become visible at fleet scale.
 *  - blinds_* are the PRODUCT metrics — what the covering actually did.
 *  - identity_* / nrfcloud_* are the PLUMBING metrics: is telemetry itself
 *    healthy, and will it still be healthy next year.
 */

/* ---------------- Thread connectivity ---------------- */

/* Role snapshot (0=disabled 1=detached 2=child 3=router 4=leader) */
MEMFAULT_METRICS_KEY_DEFINE(ot_role, kMemfaultMetricType_Unsigned)

/* Time-in-role deltas (ms per heartbeat). ot_detached_ms is the headline
 * gateway-health number: time the device could not reach its network. */
MEMFAULT_METRICS_KEY_DEFINE(ot_detached_ms, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_child_ms, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_router_ms, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_leader_ms, kMemfaultMetricType_Unsigned)

/* MLE event deltas. Elevated parent/partition churn on one ecosystem and not
 * another is the signature of a border router behaving differently. */
MEMFAULT_METRICS_KEY_DEFINE(ot_attach_attempts, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_parent_changes, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_partition_changes, kMemfaultMetricType_Unsigned)

/* Topology snapshots */
MEMFAULT_METRICS_KEY_DEFINE(ot_neighbor_count, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_router_count, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_channel, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_link_quality, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_parent_rssi, kMemfaultMetricType_Signed)

/* MAC counter deltas — RF environment quality */
MEMFAULT_METRICS_KEY_DEFINE(ot_tx_total, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_tx_retry, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_tx_err_cca, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_tx_err_abort, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_rx_err_fcs, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_rx_err_sec, kMemfaultMetricType_Unsigned)

/* ---------------- Matter fabric health ---------------- */

MEMFAULT_METRICS_KEY_DEFINE(matter_fabric_count, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(matter_subscriptions_active, kMemfaultMetricType_Unsigned)

/*
 * Vendor ID of the fabric administrator: 0x1349 Apple, 0x6006 Google,
 * 0x1217 Amazon, 0x1049 SmartThings.
 *
 * This is the single most valuable field in the whole set. Pushed as a
 * Memfault device attribute it lets every metric above be sliced by
 * ecosystem, which is a question Matter gives a manufacturer no other way to answer.
 */
MEMFAULT_METRICS_KEY_DEFINE(matter_admin_vendor_id, kMemfaultMetricType_Unsigned)

MEMFAULT_METRICS_KEY_DEFINE(matter_commissioning_count, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(matter_case_failures, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(matter_subscription_teardowns, kMemfaultMetricType_Unsigned)

/* ---------------- Product behaviour ---------------- */

/* Position in hundredths of a percent; 65535 == unknown/null */
MEMFAULT_METRICS_KEY_DEFINE(blinds_lift_position, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(blinds_tilt_position, kMemfaultMetricType_Unsigned)

/* 0=stalled 1=opening 2=closing */
MEMFAULT_METRICS_KEY_DEFINE(blinds_lift_motion, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(blinds_tilt_motion, kMemfaultMetricType_Unsigned)

/* A covering that loses calibration in the field becomes a support call. */
MEMFAULT_METRICS_KEY_DEFINE(blinds_calibrated, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(blinds_config_status, kMemfaultMetricType_Unsigned)

/* Deltas per heartbeat — duty cycle and mechanical health */
MEMFAULT_METRICS_KEY_DEFINE(blinds_moves, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(blinds_stalls, kMemfaultMetricType_Unsigned)

/* ---------------- Telemetry plumbing ---------------- */

MEMFAULT_METRICS_KEY_DEFINE(nrfcloud_upload_err, kMemfaultMetricType_Unsigned)

/*
 * Time sync is on the critical path for authentication: JWT signing and
 * certificate validity both need wall clock. A gateway that will not route
 * outbound traffic breaks SNTP and therefore breaks auth — this metric makes
 * that visible instead of leaving it to be inferred from silence.
 */
MEMFAULT_METRICS_KEY_DEFINE(time_sync_ok, kMemfaultMetricType_Unsigned)

/* identity_state: 0=unprovisioned 1=key only 2=key+certificate
 * identity_cert_days_left: alert well before this reaches zero — certificates
 * expire long before a motorised shade does. */
MEMFAULT_METRICS_KEY_DEFINE(identity_state, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(identity_cert_days_left, kMemfaultMetricType_Unsigned)

/* ---------------- Border router identity ---------------- */

/*
 * Who made the gateway this device is attached to.
 *
 * Obtained by asking the parent directly over Thread 1.3 network diagnostics
 * (TLV 25 Vendor Name, TLV 26 Vendor Model), not inferred.
 *
 * The obvious approach — OUI lookup on the parent's extended address — does
 * not work. Every border router observed so far uses a locally administered
 * EUI-64 (verified on a Nest: a62d405ee2e5cd52, local bit set), so there is no
 * manufacturer in it to read.
 *
 * Caveats encoded rather than hidden: on a multi-router mesh the parent is not
 * necessarily the border router, and the query costs a round trip, so it runs
 * once per attach rather than once per heartbeat.
 *
 * Reported as strings so the fleet can be segmented on what the gateway
 * actually calls itself. Mapping to a tidy enum belongs in the dashboard, not
 * in firmware — see matter_admin_vendor_id for why.
 */
MEMFAULT_METRICS_STRING_KEY_DEFINE(ot_br_vendor_name, 32)
MEMFAULT_METRICS_STRING_KEY_DEFINE(ot_br_vendor_model, 32)

/* Corroborating signal, and free: Google names its networks NEST-PAN-xxxx,
 * Amazon/eero AMZN-Thread-xxxx. Weaker than the vendor TLV but costs nothing. */
MEMFAULT_METRICS_STRING_KEY_DEFINE(ot_network_name, 16)

/* A gateway that does not answer diagnostics is itself a finding. */
MEMFAULT_METRICS_KEY_DEFINE(ot_br_query_failures, kMemfaultMetricType_Unsigned)

/* ---------------- Thread, extended ---------------- */

/*
 * Data poll period. On a sleepy end device this is the dominant term in radio
 * duty cycle, so it is the closest proxy to energy cost we can report without
 * a power monitor.
 */
MEMFAULT_METRICS_KEY_DEFINE(ot_poll_period_ms, kMemfaultMetricType_Unsigned)

/* MAC counter deltas — the rest of the RF picture */
MEMFAULT_METRICS_KEY_DEFINE(ot_rx_total, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_tx_acked, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_tx_err_busy, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_rx_duplicated, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_rx_err_no_frame, kMemfaultMetricType_Unsigned)

/* IPv6 forwarding failures — distinguishes "radio is fine, routing is not" */
MEMFAULT_METRICS_KEY_DEFINE(ot_ip6_tx_fail, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_ip6_rx_fail, kMemfaultMetricType_Unsigned)

MEMFAULT_METRICS_KEY_DEFINE(ot_rloc16, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(ot_child_timeout_s, kMemfaultMetricType_Unsigned)

/*
 * SRP registration state. Matter operational discovery depends on it, so a
 * device that is on Thread but not SRP-registered is reachable by us and
 * invisible to the ecosystem — a failure mode with no other symptom.
 */
MEMFAULT_METRICS_KEY_DEFINE(ot_srp_registered, kMemfaultMetricType_Unsigned)

/*
 * Whether the gateway publishes a NAT64 prefix, probed by attempting a
 * synthesis and checking the error. This is the gateway-compatibility question
 * Warema actually asked, answered as a fleet metric: a device behind a
 * NAT64-less border router cannot reach the cloud at all.
 */
MEMFAULT_METRICS_KEY_DEFINE(ot_nat64_available, kMemfaultMetricType_Unsigned)

/* ---------------- Telemetry plumbing, extended ---------------- */

/*
 * Upload cost breakdown. nrfcloud_auth_ms exists because nRF Cloud's response
 * to POST /auth/jwt was observed at a consistent 19.1 s — identical to the
 * millisecond across runs, success and failure alike. On a battery device that
 * is a material energy cost, and it needs to be a measured fleet number rather
 * than one lab anecdote.
 */
MEMFAULT_METRICS_KEY_DEFINE(nrfcloud_handshake_ms, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(nrfcloud_auth_ms, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(nrfcloud_connect_ms, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(nrfcloud_chunks_sent, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(nrfcloud_bytes_sent, kMemfaultMetricType_Unsigned)

/* Cold-boot time sync took three attempts (~37 s) on first hardware run. */
MEMFAULT_METRICS_KEY_DEFINE(sntp_sync_ms, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(sntp_attempts, kMemfaultMetricType_Unsigned)

/* ---------------- Product behaviour, extended ---------------- */

/*
 * Cumulative travel in percent-of-full-range. The mechanical wear proxy: a
 * shade rated for N full cycles can be tracked against its actual duty.
 */
MEMFAULT_METRICS_KEY_DEFINE(blinds_travel_pct_total, kMemfaultMetricType_Unsigned)

/* Obstruction detection trips — the support-call predictor. */
MEMFAULT_METRICS_KEY_DEFINE(blinds_obstructions, kMemfaultMetricType_Unsigned)

/* Motor current at last sample; rising trend indicates binding mechanism. */
MEMFAULT_METRICS_KEY_DEFINE(blinds_motor_current_ma, kMemfaultMetricType_Unsigned)

/*
 * Per-movement session. Each covering movement produces its own report, which
 * is how a mechanical fault shows up as a trend across thousands of units
 * rather than as a single anomalous heartbeat.
 */
MEMFAULT_METRICS_SESSION_KEY_DEFINE(blinds_movement)

MEMFAULT_METRICS_KEY_DEFINE_WITH_SESSION(
	move_duration_ms, kMemfaultMetricType_Unsigned, blinds_movement)
MEMFAULT_METRICS_KEY_DEFINE_WITH_SESSION(
	move_distance_pct, kMemfaultMetricType_Unsigned, blinds_movement)
MEMFAULT_METRICS_KEY_DEFINE_WITH_SESSION(
	move_peak_current_ma, kMemfaultMetricType_Unsigned, blinds_movement)
MEMFAULT_METRICS_KEY_DEFINE_WITH_SESSION(
	move_stalls, kMemfaultMetricType_Unsigned, blinds_movement)
